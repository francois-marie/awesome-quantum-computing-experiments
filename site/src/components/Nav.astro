---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Plots' },
  { href: '/experiments', label: 'Experiments' },
  { href: '/platforms', label: 'Platforms' },
  { href: '/rankings', label: 'Rankings' },
  { href: '/records', label: 'Records' },
  { href: '/groups', label: 'Groups' },
  { href: '/qday', label: 'Q-day' },
];
---

<header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href={`${base}/`} class="flex items-center gap-2 font-semibold tracking-tight">
      <img src={`${base}/atom-emoji.png`} alt="" width="22" height="22" class="size-[22px]" />
      <span class="hidden sm:inline">Quantum Computing Experiments</span>
      <span class="sm:hidden">AQCE</span>
    </a>
    <nav class="ml-auto flex items-center gap-1 overflow-x-auto text-sm">
      {links.map((l) => (
        <a
          href={`${base}${l.href === '/' ? '/' : l.href}`}
          class:list={[
            'rounded-md px-2.5 py-1.5 whitespace-nowrap transition-colors hover:bg-muted',
            path === l.href ? 'text-foreground font-medium' : 'text-muted-foreground',
          ]}
          aria-current={path === l.href ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
      <a
        href="https://github.com/francois-marie/awesome-quantum-computing-experiments"
        class="ml-1 rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="GitHub repository"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md px-2 py-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        aria-label="Toggle dark mode"
      >
        <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
        <svg class="hidden size-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
