---
import Base from '@/layouts/Base.astro';
import RecordCard from '@/components/RecordCard.astro';
import { FigureChart } from '@/components/FigureChart';
import { FIGURES, figuresByName } from '@/lib/figures';
import { datasets, totals } from '@/lib/data';
import { METRICS, recordHistory } from '@/lib/metrics';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/francois-marie/awesome-quantum-computing-experiments';

const records = METRICS.filter((m) => m.aggregate === 'best')
  .map((m) => {
    const chain = recordHistory(m);
    return { metric: m, record: chain[chain.length - 1], previous: chain[chain.length - 2] ?? null };
  })
  .filter((r) => r.record);
---

<Base>
  <section class="flex flex-col gap-5 pb-10 pt-6 sm:pt-10">
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
      Quantum computing experiments, as data.
    </h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      A curated database of {totals.entries} experimental results from {totals.papers} papers, with an emphasis on quantum error
      correction. Every plot on this page is generated from five CSV files.
    </p>
    <div class="flex flex-wrap gap-2 text-sm">
      <a href={`${base}/experiments`} class="rounded-md bg-primary px-3 py-1.5 font-medium text-primary-foreground hover:opacity-90">Browse the tables</a>
      <a href={`${repo}/tree/main/data`} class="rounded-md border px-3 py-1.5 hover:bg-muted">Get the CSV files</a>
      <a href="https://arxiv.org/abs/2507.03678" class="rounded-md border px-3 py-1.5 hover:bg-muted">Read the paper</a>
    </div>
    <dl class="mt-2 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
      {[
        ['Entries', totals.entries],
        ['Papers', totals.papers],
        ['Platforms', totals.platforms],
        ['Latest year', totals.latestYear],
      ].map(([k, v]) => (
        <div class="border-l pl-3">
          <dt class="text-muted-foreground">{k}</dt>
          <dd class="text-xl font-semibold tabular-nums">{v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="records" class="scroll-mt-20 py-8">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-xl font-semibold tracking-tight">Current records</h2>
      <a href={`${base}/records`} class="text-sm text-muted-foreground underline-offset-4 hover:underline">Full history →</a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {records.map(({ metric, record, previous }) => <RecordCard metric={metric} record={record} previous={previous} />)}
    </div>
  </section>

  <section class="py-8">
    <h2 class="mb-1 text-xl font-semibold tracking-tight">Plots</h2>
    <p class="mb-6 text-sm text-muted-foreground">
      Click a legend entry to hide it. Hover a point for the paper. Each plot links to its rows in the tables.
    </p>
    <div class="flex flex-col gap-10">
      {FIGURES.map((f) => {
        const figure = figuresByName[f.name];
        if (!figure) return null;
        return (
          <article id={f.anchor} class="scroll-mt-20 rounded-xl border bg-card p-4 sm:p-6">
            <header class="mb-4 flex flex-wrap items-start justify-between gap-2">
              <div>
                <h3 class="text-base font-semibold">{f.title}</h3>
                <p class="text-sm text-muted-foreground">{f.description}</p>
              </div>
              <div class="flex gap-3 text-xs text-muted-foreground">
                <a href={`${base}/experiments#${f.dataset}`} class="underline-offset-4 hover:underline">{datasets[f.dataset].file}</a>
                <a href={`${repo}/blob/main/out/png/${f.name}.png`} class="underline-offset-4 hover:underline">PNG</a>
                <a href={`#${f.anchor}`} class="underline-offset-4 hover:underline">#</a>
              </div>
            </header>
            <FigureChart client:visible figure={figure} height={f.name === 'qec_platform_sunburst' ? 680 : 440} />
          </article>
        );
      })}
    </div>
  </section>
</Base>
